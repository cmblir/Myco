{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities granted to the main, tray-panel, spotlight and notch windows",
  "windows": ["main", "tray-panel", "spotlight", "notch"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:default",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
