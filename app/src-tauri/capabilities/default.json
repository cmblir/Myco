{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities granted to the main and tray-panel windows",
  "windows": ["main", "tray-panel"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:default",
    "notification:default",
    "updater:default"
  ]
}
